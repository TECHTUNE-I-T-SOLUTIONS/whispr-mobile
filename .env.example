# Whispr Mobile App Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# SUPABASE CONFIGURATION
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# API CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Production: NEXT_PUBLIC_API_URL=https://your-domain.com/api

# ============================================
# PAYSTACK CONFIGURATION
# ============================================
# Public key for the mobile app (safe to expose)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Currency configuration
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_EXCHANGE_RATE_TO_NGN=1500

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_ENV=development
# Production: NEXT_PUBLIC_APP_ENV=production

NEXT_PUBLIC_APP_NAME=Whispr
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================
# FEATURE FLAGS (Client-side)
# ============================================
# These can be overridden by server-side feature flags
NEXT_PUBLIC_PREMIUM_ENABLED=true
NEXT_PUBLIC_AI_PREMIUM_ENABLED=true
NEXT_PUBLIC_GAMES_PREMIUM_ENABLED=true
NEXT_PUBLIC_FREE_TRIAL_ENABLED=true

# ============================================
# ANALYTICS & MONITORING
# ============================================
# Add your analytics keys here if needed
# NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_CRASHLYTICS_KEY=

# ============================================
# DEBUGGING
# ============================================
# Enable debug logs in development
NEXT_PUBLIC_DEBUG_MODE=true
# Production: NEXT_PUBLIC_DEBUG_MODE=false
